{
  "name": "resto-huma",
  "version": "0.0.1",
  "private": true,
  "description": "Sistema de gesti\u00f3n para restaurante de comida regional del norte argentino",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev:backend": "pnpm --filter backend start:dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build": "pnpm --filter @resto-huma/shared build && pnpm -r --workspace-concurrency=1 build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter backend exec prisma migrate dev",
    "db:seed": "pnpm --filter backend exec tsx prisma/seed.ts"
  }
}