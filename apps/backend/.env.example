# Base de datos (docker-compose.yml)
DATABASE_URL="postgresql://resto:resto@localhost:5432/resto_huma?schema=public"

# JWT
JWT_SECRET=cambiar-en-produccion
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_CLIENT_TTL=30d

# Google OAuth (clientes)
GOOGLE_CLIENT_ID=

# Pasarela de pagos (servicio externo — proyecto aparte)
PAYMENT_PROVIDER=manual            # manual | externa
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_KEY=
PAYMENT_WEBHOOK_SECRET=

# App
PORT=3001
